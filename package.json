{
  "name": "mini-sk-pc",
  "version": "1.0.0",
  "description": "Mini SK para PC — editor com terminal do computador e Ollama",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "programa": "electron .",
    "exe": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.minisk.pc",
    "productName": "Mini SK",
    "executableName": "Mini-SK",
    "directories": { "output": "release" },
    "files": ["app/**/*", "electron/**/*", "package.json"],
    "asar": false,
    "win": { "target": ["nsis", "portable"], "icon": "app/icons/icon-512.png" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Mini SK", "artifactName": "Mini-SK-Instalar.exe" },
    "portable": { "artifactName": "Mini-SK-sem-instalar.exe" }
  }
}
